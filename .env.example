APP_NAME=AI标书Agent
APP_ENV=development

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=bid_agent
POSTGRES_USER=biduser
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_CONNECT_TIMEOUT=5

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

DASHSCOPE_API_KEY=
OPENAI_API_KEY=
