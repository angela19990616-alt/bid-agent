APP_NAME=AI标书Agent
APP_ENV=development

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=bid_agent
POSTGRES_USER=biduser
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_CONNECT_TIMEOUT=5
ENABLE_LEGACY_API=false
# Private shared secret between the authorized Sites gateway and ECS API.
BID_AGENT_EDGE_SECRET=replace-with-a-long-random-secret
# Public trial gate. Rotate this value to invalidate issued access cookies.
BID_AGENT_INVITE_CODE=replace-with-a-private-invite-code
BID_AGENT_INVITE_ACCESS_TTL_HOURS=168

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# 百炼按量计费或允许生产使用的团队版 API Key。
# Token Plan 个人版禁止用于公网生产自动化服务。
# 真实 Key 仅写入本地或服务器 .env，不要提交到 Git。
DASHSCOPE_API_KEY=
# 预留 OpenAI 官方接口；使用百炼时保持为空。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
MAX_UPLOAD_SIZE_MB=20
STORAGE_ROOT=storage
EXPORT_ROOT=exports
# Versioned rule files; active database rules can override these defaults.
RULES_ROOT=config/rules
