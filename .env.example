APP_NAME=AI标书Agent
APP_ENV=development

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=bid_agent
POSTGRES_USER=biduser
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_CONNECT_TIMEOUT=5
ENABLE_LEGACY_API=false
# Private shared secret between the authorized Sites gateway and ECS API.
BID_AGENT_EDGE_SECRET=replace-with-a-long-random-secret
# Public trial gate. Rotate this value to invalidate issued access cookies.
BID_AGENT_INVITE_CODE=replace-with-a-private-invite-code
BID_AGENT_INVITE_ACCESS_TTL_HOURS=168

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# Neo4j 仅保存可从 PostgreSQL 重建的业务关系投影，不作为事实主库。
# 生产必须替换密码；7474/7687 仅绑定回环地址，不对公网开放。
NEO4J_ENABLED=true
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-strong-graph-password
NEO4J_DATABASE=neo4j

# 百炼按量计费或允许生产使用的团队版 API Key。
# Token Plan 个人版禁止用于公网生产自动化服务。
# 真实 Key 仅写入本地或服务器 .env，不要提交到 Git。
DASHSCOPE_API_KEY=
# DeepSeek 官方接口密钥；真实值只写入 .env，不提交 Git。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 预留 OpenAI 官方接口；使用百炼时保持为空。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 百炼任务路由。优先填写最近发布且能力等级最高、已在当前业务空间
# 获授权的模型；实际失败后再按 model_routing 规则有限降级。
# 百炼不会在免费额度耗尽后自动切换；请在控制台开启“免费额度用完即停”。
LLM_MODEL=deepseek-v4-flash
EXTRACTION_MODEL=deepseek-v4-flash
CLASSIFICATION_MODEL=deepseek-v4-flash
WRITING_MODEL=deepseek-v4-pro
REVIEW_MODEL=deepseek-v4-pro
# 单个受控 workflow 的硬预算；达到上限后保留断点并停止模型调用。
MAX_MODEL_CALLS_PER_WORKFLOW=40
MAX_MODEL_TOKENS_PER_WORKFLOW=300000
# 单次供应商请求的最长等待；超时后按 model_routing 规则切换备用模型。
MODEL_REQUEST_TIMEOUT_SECONDS=180
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
MAX_UPLOAD_SIZE_MB=20
STORAGE_ROOT=storage
EXPORT_ROOT=exports
# Versioned rule files; active database rules can override these defaults.
RULES_ROOT=config/rules
