{
  "key": "default-privacy-redaction",
  "rule_type": "privacy_redaction",
  "version": 1,
  "name": "模型调用前本地隐私脱敏规则",
  "description": "仅在本地内存中替换个人敏感信息，模型返回后按原占位符恢复；原文与映射不发送给外部模型。",
  "rules": [
    {
      "category": "身份证号",
      "pattern": "(?<![0-9])(?:[1-9][0-9]{5})(?:18|19|20)[0-9]{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12][0-9]|3[01])[0-9]{3}[0-9Xx](?![0-9])"
    },
    {
      "category": "手机号",
      "pattern": "(?<![0-9])(?:\\+?86[- ]?)?1[3-9][0-9]{9}(?![0-9])"
    },
    {
      "category": "电子邮箱",
      "pattern": "(?i)(?<![A-Za-z0-9._%+-])[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}(?![A-Za-z0-9.-])"
    },
    {
      "category": "固定电话",
      "pattern": "(?<![0-9])0[0-9]{2,3}[- ]?[0-9]{7,8}(?![0-9])"
    },
    {
      "category": "联系人",
      "pattern": "(?:联系人|联络人|负责人)\\s*[：:]\\s*([一-龥·]{2,8})",
      "value_group": 1
    },
    {
      "category": "联系地址",
      "pattern": "(?:联系地址|通讯地址|收件地址)\\s*[：:]\\s*([^\\n,，;；]{6,100})",
      "value_group": 1
    },
    {
      "category": "银行账号",
      "pattern": "(?:银行账号|银行账户|银行卡号|收款账号)\\s*[：:]\\s*([0-9][0-9 -]{14,25}[0-9])",
      "value_group": 1
    }
  ]
}
