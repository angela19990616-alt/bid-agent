{
  "key": "default-template-generation",
  "rule_type": "template_generation",
  "version": 1,
  "name": "投标响应模板优先规则",
  "priority": ["strict_template", "planned"],
  "writer_strategies": [
    "strict_template_writer",
    "planned_proposal_writer"
  ],
  "policies": {
    "preserve_original_package": true,
    "preserve_block_order": true,
    "preserve_tables": true,
    "preserve_styles": true,
    "fill_verified_values_only": true,
    "never_guess_missing_fields": true,
    "historical_cases_are_structure_only": true,
    "historical_case_facts_are_prohibited": true,
    "detected_template_is_primary_structure": true,
    "writing_section_patterns": [
      "项目实施方案",
      "技术方案",
      "服务方案",
      "工作方案",
      "实施计划",
      "组织管理",
      "进度计划",
      "质量保障",
      "运维保障",
      "培训方案",
      "安全保障"
    ],
    "non_writing_section_patterns": [
      "投标函",
      "开标一览表",
      "报价表",
      "偏离表",
      "应答表",
      "声明函",
      "承诺函",
      "授权委托书",
      "资格证明",
      "中小企业声明",
      "人员情况表",
      "业绩表"
    ]
  },
  "pdf_policy": {
    "convert_to_editable_docx_before_template_detection": true,
    "converted_template_detected": "strict_template_writer",
    "converted_template_not_detected": "planned_proposal_writer",
    "conversion_failed": "template_conversion_required",
    "do_not_treat_conversion_failure_as_no_template": true,
    "do_not_claim_exact_fill_without_structure_validation": true
  }
}
