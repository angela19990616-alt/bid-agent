{
  "key": "default-model-routing",
  "rule_type": "model_routing",
  "version": 5,
  "name": "模型受控切换规则",
  "description": "优先调用最近发布的高级模型；按任务、健康状态、输入限制和费用边界进行有限降级。",
  "priority_policy": {
    "strategy": "latest_capable_first",
    "description": "任务候选列表必须按近期高级模型、稳定高级模型、普通备用模型排序；仅在失败、无权限、超时或额度不可用时向后切换。",
    "allow_silent_quality_downgrade": false
  },
  "max_attempts": 10,
  "max_billable_failures": 2,
  "cooldown_seconds": 1800,
  "model_pool": [
    {"id": "deepseek-chat", "provider": "deepseek", "tasks": ["extraction", "classification"], "quality_tier": "stable_advanced", "max_input_chars": 24000, "max_output_tokens": 5000},
    {"id": "deepseek-reasoner", "provider": "deepseek", "tasks": ["writing", "review"], "quality_tier": "reasoning_advanced", "max_input_chars": 24000, "max_output_tokens": 5000},
    {"id": "qwen3.7-plus", "tasks": ["extraction", "writing", "classification", "review"], "quality_tier": "latest_advanced", "max_input_chars": 24000, "max_output_tokens": 5000},
    {"id": "qwen-max", "tasks": ["extraction", "writing", "classification", "review"], "quality_tier": "advanced", "max_input_chars": 24000, "max_output_tokens": 5000},
    {"id": "glm-5", "tasks": ["extraction", "writing", "classification", "review"], "quality_tier": "advanced", "max_input_chars": 24000, "max_output_tokens": 5000},
    {"id": "deepseek-v3", "tasks": ["extraction", "writing", "classification", "review"], "quality_tier": "advanced", "max_input_chars": 24000, "max_output_tokens": 5000},
    {"id": "qwen3-max", "tasks": ["extraction", "writing", "classification", "review"], "quality_tier": "advanced", "max_input_chars": 24000, "max_output_tokens": 5000},
    {"id": "qwen-plus-latest", "tasks": ["extraction", "writing", "classification", "review"], "max_input_chars": 24000, "max_output_tokens": 5000},
    {"id": "qwen3.7-flash", "tasks": ["extraction", "writing", "classification", "review"], "max_input_chars": 24000, "max_output_tokens": 5000},
    {"id": "qwen3.5-plus", "tasks": ["extraction", "writing", "classification", "review"], "max_input_chars": 24000, "max_output_tokens": 5000},
    {"id": "deepseek-v3.2", "tasks": ["writing", "classification", "review"], "max_input_chars": 24000, "max_output_tokens": 5000},
    {"id": "qwen3-235b-a22b-instruct-2507", "tasks": ["extraction", "writing", "classification", "review"], "max_input_chars": 24000, "max_output_tokens": 5000},
    {"id": "deepseek-r1-distill-qwen-32b", "tasks": ["writing", "classification", "review"], "max_input_chars": 20000, "max_output_tokens": 4000}
  ],
  "task_fallbacks": {
    "extraction": ["deepseek-chat", "qwen3.7-plus", "qwen-max", "glm-5", "deepseek-v3", "qwen3-max", "qwen-plus-latest", "qwen3-235b-a22b-instruct-2507", "qwen3.5-plus", "qwen3.7-flash"],
    "classification": ["deepseek-chat", "deepseek-reasoner", "qwen3.7-plus", "qwen-max", "glm-5", "deepseek-v3", "qwen3-max", "deepseek-v3.2", "qwen3-235b-a22b-instruct-2507", "deepseek-r1-distill-qwen-32b"],
    "writing": ["deepseek-reasoner", "deepseek-chat", "qwen3.7-plus", "qwen-max", "glm-5", "deepseek-v3", "qwen3-max", "qwen-plus-latest", "qwen3.7-flash", "qwen3.5-plus"],
    "review": ["deepseek-reasoner", "deepseek-chat", "qwen3.7-plus", "qwen-max", "glm-5", "deepseek-v3", "qwen3-max", "deepseek-v3.2", "qwen3-235b-a22b-instruct-2507", "deepseek-r1-distill-qwen-32b"],
    "default": ["deepseek-chat", "deepseek-reasoner", "qwen3.7-plus", "qwen-max", "glm-5", "deepseek-v3", "qwen3-max", "qwen-plus-latest", "qwen3.7-flash", "qwen3.5-plus"]
  },
  "retryable_status_codes": [403, 404, 408, 409, 429, 500, 502, 503, 504],
  "zero_usage_status_codes": [403, 404, 429],
  "zero_usage_error_markers": [
    "range of input length",
    "invalidparameter",
    "model access forbidden",
    "model not found",
    "未开通",
    "无权限"
  ],
  "retryable_error_markers": [
    "quota",
    "insufficient",
    "额度",
    "余额不足",
    "rate limit",
    "too many requests",
    "model not found",
    "模型不存在",
    "未开通",
    "forbidden",
    "access denied",
    "permission denied",
    "no permission",
    "not authorized for this model",
    "range of input length",
    "invalidparameter",
    "temporarily unavailable",
    "service unavailable",
    "timeout",
    "timed out"
  ]
}
