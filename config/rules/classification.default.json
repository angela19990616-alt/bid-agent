{
  "rule_type": "classification",
  "key": "proposal-oriented-classification",
  "name": "面向技术方案生成的 Requirement 分类规则",
  "version": 1,
  "model_instruction": "你是投标技术方案分类器。不要回答“这是不是技术要求”，而要判断该要求会影响技术方案的哪一部分。对每条要求回答：投标人需要响应什么、应写入哪一章、是否影响评分、是否需要企业知识支持。只能使用规则中定义的枚举；资格、商务和合规要求不得进入技术方案正文。只返回完整 JSON，不输出 Markdown。",
  "requirement_types": {
    "technical_capability": {"label": "技术能力", "default_chapter": "技术路线"},
    "functional_requirement": {"label": "功能要求", "default_chapter": "系统功能设计"},
    "system_architecture": {"label": "系统架构", "default_chapter": "总体技术架构"},
    "security_requirement": {"label": "安全要求", "default_chapter": "数据安全方案"},
    "performance_requirement": {"label": "性能要求", "default_chapter": "总体技术架构"},
    "implementation_requirement": {"label": "实施要求", "default_chapter": "实施计划"},
    "project_management": {"label": "项目管理", "default_chapter": "项目组织管理"},
    "operation_maintenance": {"label": "运维要求", "default_chapter": "运维保障方案"},
    "training_requirement": {"label": "培训要求", "default_chapter": "培训方案"},
    "delivery_requirement": {"label": "交付要求", "default_chapter": "实施计划"},
    "commercial_requirement": {"label": "商务要求", "default_chapter": null},
    "qualification_requirement": {"label": "资格要求", "default_chapter": null},
    "scoring_requirement": {"label": "评分要求", "default_chapter": "技术评分点响应"},
    "other": {"label": "其他", "default_chapter": "其他"}
  },
  "classifiers": [
    {"type": "qualification_requirement", "keywords": ["不得存在失信", "失信情况", "资格条件", "资质证书", "法定代表人", "营业执照"], "chapter": null, "need_generation": false, "priority": 100},
    {"type": "commercial_requirement", "keywords": ["报价", "付款", "保证金", "合同价", "发票", "密封"], "chapter": null, "need_generation": false, "priority": 95},
    {"type": "scoring_requirement", "keywords": ["评分", "得分", "加分", "分值"], "chapter": "技术评分点响应", "need_generation": true, "priority": 90},
    {"type": "training_requirement", "keywords": ["培训", "授课", "培训教材"], "chapter": "培训方案", "need_generation": true, "priority": 88},
    {"type": "operation_maintenance", "keywords": ["运维", "维护", "售后", "7×24", "7*24", "响应时间", "故障处理"], "chapter": "运维保障方案", "need_generation": true, "priority": 86},
    {"type": "functional_requirement", "keywords": ["功能", "支持用户", "用户管理", "模块", "查询", "统计", "展示"], "chapter": "系统功能设计", "need_generation": true, "priority": 85},
    {"type": "security_requirement", "keywords": ["安全", "权限控制", "日志审计", "等保", "加密", "备份", "容灾"], "chapter": "数据安全方案", "need_generation": true, "priority": 84},
    {"type": "system_architecture", "keywords": ["架构", "平台", "技术路线", "系统设计", "国产化数据库", "部署架构"], "chapter": "总体技术架构", "need_generation": true, "priority": 82},
    {"type": "performance_requirement", "keywords": ["并发", "吞吐", "响应时间", "性能", "可用性"], "chapter": "总体技术架构", "need_generation": true, "priority": 80},
    {"type": "project_management", "keywords": ["项目经理", "项目团队", "人员配置", "组织管理", "沟通机制"], "chapter": "项目组织管理", "need_generation": true, "priority": 78},
    {"type": "implementation_requirement", "keywords": ["实施周期", "服务期限", "工期", "进度", "上线", "部署", "实施计划"], "chapter": "实施计划", "need_generation": true, "priority": 76},
    {"type": "delivery_requirement", "keywords": ["交付", "验收", "成果文件", "提交成果"], "chapter": "实施计划", "need_generation": true, "priority": 74},
    {"type": "technical_capability", "keywords": ["技术能力", "兼容", "接口", "集成", "技术要求"], "chapter": "技术路线", "need_generation": true, "priority": 70}
  ],
  "chapter_mapping": {
    "项目理解": ["项目背景", "建设目标", "需求理解"],
    "总体技术架构": ["system_architecture", "performance_requirement"],
    "系统功能设计": ["functional_requirement"],
    "技术路线": ["technical_capability"],
    "数据安全方案": ["security_requirement"],
    "实施计划": ["implementation_requirement", "delivery_requirement"],
    "项目组织管理": ["project_management"],
    "运维保障方案": ["operation_maintenance"],
    "培训方案": ["training_requirement"],
    "服务承诺": ["服务承诺"],
    "技术评分点响应": ["scoring_requirement"]
  },
  "scoring_keywords": {
    "high_score_item": ["重点评分", "满分", "最高得分", "分值"],
    "medium_score_item": ["评分", "得分", "加分"]
  },
  "importance_keywords": {
    "critical": ["必须", "不得", "否决", "废标", "实质性"],
    "high": ["应当", "须", "关键", "重点"],
    "medium": ["应", "需要", "要求"]
  },
  "knowledge_keywords": ["企业", "资质", "案例", "经验", "团队", "产品能力", "技术能力"],
  "high_confidence_threshold": 0.8,
  "low_confidence_threshold": 0.6,
  "output_schema": {
    "classifications": [{
      "source_ref": "R1",
      "requirement_type": "functional_requirement",
      "proposal_chapter": "系统功能设计",
      "scoring_relation": "requirement_only",
      "importance": "high",
      "confidence": 0.9,
      "knowledge_support_required": false,
      "rationale": "简短、面向方案用途的理由"
    }]
  }
}
