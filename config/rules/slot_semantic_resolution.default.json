{
  "key": "default-slot-semantic-resolution",
  "rule_type": "slot_semantic_resolution",
  "version": "1.0.0",
  "name": "投标文件空位 AI 语义识别规则",
  "enabled": true,
  "batch_size": 24,
  "max_input_chars": 18000,
  "min_apply_confidence": 0.9,
  "action_min_confidence": 0.92,
  "review_confidence_below": 0.9,
  "ambiguous_labels": ["姓名", "姓名/职务", "名称", "日期", "时间", "编号", "职务", "负责人", "代表", "联系人", "联系电话"],
  "instructions": [
    "结合章节标题、整句、表格表头、行列位置和相邻文字判断空位含义，不得只看括号内的单个词。",
    "先判断空位指向的业务实体，再判断项目角色，最后判断具体属性。",
    "法定代表人、授权代表、项目负责人、技术负责人、联系人和签署人是不同角色，不得互换。",
    "同一投标文件中的投标人、供应商、响应人、本单位和我方默认指向当前投标主体；只有原文明示联合体或其他主体时才拆分。",
    "签字、盖章、签章等纯动作不是文本值；带有名称、姓名、日期等值标签时，值与动作必须分开。",
    "日期必须结合上下文区分投标文件签署日期、合同日期、项目期限或人员时间；不能把所有日期机械归成同一字段。",
    "无法唯一判断时返回 uncertain，不得猜测人员、企业事实或不存在的属性。"
  ],
  "concepts": {
    "project_name": {"semantic_field": "project.name", "canonical_key": "project_name", "entity_type": "Project", "value_type": "project_name", "subject_role": "CURRENT_PROJECT", "fill_strategy": "direct_attribute", "display_name": "项目名称", "relation_path": ["当前项目", "项目名称"]},
    "project_number": {"semantic_field": "project.number", "canonical_key": "project_number", "entity_type": "Project", "value_type": "project_identifier", "subject_role": "CURRENT_PROJECT", "fill_strategy": "direct_attribute", "display_name": "项目编号", "relation_path": ["当前项目", "项目编号"]},
    "project_reference": {"semantic_field": "project.reference", "canonical_key": "project_reference", "entity_type": "Project", "value_type": "project_reference", "subject_role": "CURRENT_PROJECT", "fill_strategy": "composed_value", "display_name": "项目名称及编号", "relation_path": ["当前项目", "项目名称及编号"]},
    "procurer_name": {"semantic_field": "project.procurer_name", "canonical_key": "procurer_name", "entity_type": "Project", "value_type": "organization_name", "subject_role": "CURRENT_PROJECT", "fill_strategy": "direct_attribute", "display_name": "采购人名称", "relation_path": ["当前项目", "采购人", "企业全称"]},
    "procurement_agency_name": {"semantic_field": "project.procurement_agency_name", "canonical_key": "procurement_agency_name", "entity_type": "Project", "value_type": "organization_name", "subject_role": "CURRENT_PROJECT", "fill_strategy": "direct_attribute", "display_name": "采购代理机构名称", "relation_path": ["当前项目", "采购代理机构", "企业全称"]},
    "bidder_name": {"semantic_field": "organization.full_name", "canonical_key": "bidder_name", "entity_type": "Organization", "value_type": "organization_name", "subject_role": "BIDDER_ORGANIZATION", "fill_strategy": "direct_attribute", "display_name": "投标人名称", "relation_path": ["当前项目", "投标人", "企业全称"]},
    "registered_address": {"semantic_field": "organization.registered_address", "canonical_key": "registered_address", "entity_type": "Organization", "value_type": "address", "subject_role": "BIDDER_ORGANIZATION", "fill_strategy": "direct_attribute", "display_name": "投标人注册地址", "relation_path": ["当前项目", "投标人", "注册地址"]},
    "postal_code": {"semantic_field": "organization.postal_code", "canonical_key": "postal_code", "entity_type": "Organization", "value_type": "postal_code", "subject_role": "BIDDER_ORGANIZATION", "fill_strategy": "direct_attribute", "display_name": "投标人邮政编码", "relation_path": ["当前项目", "投标人", "邮政编码"]},
    "organization_phone": {"semantic_field": "organization.phone", "canonical_key": "contact_phone", "entity_type": "Organization", "value_type": "phone", "subject_role": "BIDDER_ORGANIZATION", "fill_strategy": "direct_attribute", "display_name": "投标人联系电话", "relation_path": ["当前项目", "投标人", "联系电话"]},
    "fax": {"semantic_field": "organization.fax", "canonical_key": "fax", "entity_type": "Organization", "value_type": "phone", "subject_role": "BIDDER_ORGANIZATION", "fill_strategy": "direct_attribute", "display_name": "投标人传真", "relation_path": ["当前项目", "投标人", "传真"]},
    "website": {"semantic_field": "organization.website", "canonical_key": "website", "entity_type": "Organization", "value_type": "website", "subject_role": "BIDDER_ORGANIZATION", "fill_strategy": "direct_attribute", "display_name": "投标人网站", "relation_path": ["当前项目", "投标人", "网站"]},
    "bank_account": {"semantic_field": "organization.bank_account", "canonical_key": "bank_account", "entity_type": "Organization", "value_type": "bank_account", "subject_role": "BIDDER_ORGANIZATION", "fill_strategy": "direct_attribute", "display_name": "投标人银行账号", "relation_path": ["当前项目", "投标人", "银行账号"]},
    "person_name": {"semantic_field": "person.name", "canonical_key": "person_name", "entity_type": "Person", "value_type": "person_name", "fill_strategy": "direct_attribute", "attribute_label": "姓名"},
    "person_name_and_title": {"semantic_field": "person.name_and_title", "canonical_key": "person_name_and_title", "entity_type": "Person", "value_type": "person_reference", "fill_strategy": "composed_value", "attribute_label": "姓名及职务"},
    "person_title": {"semantic_field": "person.title", "canonical_key": "person_title", "entity_type": "Person", "value_type": "job_title", "fill_strategy": "direct_attribute", "attribute_label": "职务"},
    "person_id_number": {"semantic_field": "person.id_number", "canonical_key": "person_id_number", "entity_type": "Person", "value_type": "identity_number", "fill_strategy": "direct_attribute", "attribute_label": "身份证号码"},
    "person_phone": {"semantic_field": "person.phone", "canonical_key": "contact_phone", "entity_type": "Person", "value_type": "phone", "fill_strategy": "direct_attribute", "attribute_label": "联系电话"},
    "professional_title": {"semantic_field": "person.professional_title", "canonical_key": "person_professional_title", "entity_type": "Person", "value_type": "professional_title", "fill_strategy": "direct_attribute", "attribute_label": "技术职称"},
    "signing_date": {"semantic_field": "bid_response.signing_date", "canonical_key": "bid_response_signing_date", "entity_type": null, "value_type": "date", "subject_role": "BID_RESPONSE_DOCUMENT", "fill_strategy": "composed_value", "display_name": "投标文件签署日期", "relation_path": ["当前项目", "投标文件", "签署日期"]},
    "bid_round": {"semantic_field": "bid_response.bid_round", "canonical_key": "bid_round", "entity_type": null, "value_type": "bid_round", "subject_role": "BID_RESPONSE_DOCUMENT", "fill_strategy": "composed_value", "display_name": "报价轮次", "relation_path": ["当前项目", "投标文件", "报价轮次"]},
    "response_requirement_reference": {"semantic_field": "bid_response.response_item.requirement_reference", "canonical_key": "response_requirement_reference", "entity_type": "ResponseItem", "value_type": "requirement_reference", "subject_role": "RESPONSE_TABLE", "fill_strategy": "generated_collection", "display_name": "采购文件条款编号", "relation_path": ["当前项目", "投标文件", "响应表", "采购文件条款编号"]},
    "response_requirement_text": {"semantic_field": "bid_response.response_item.requirement_text", "canonical_key": "response_requirement_text", "entity_type": "ResponseItem", "value_type": "requirement_text", "subject_role": "RESPONSE_TABLE", "fill_strategy": "generated_collection", "display_name": "采购文件要求", "relation_path": ["当前项目", "投标文件", "响应表", "采购文件要求"]},
    "response_text": {"semantic_field": "bid_response.response_item.response_text", "canonical_key": "response_text", "entity_type": "ResponseItem", "value_type": "response_text", "subject_role": "RESPONSE_TABLE", "fill_strategy": "generated_collection", "display_name": "投标响应内容", "relation_path": ["当前项目", "投标文件", "响应表", "投标响应内容"]},
    "deviation_status": {"semantic_field": "bid_response.response_item.deviation_status", "canonical_key": "deviation_status", "entity_type": "ResponseItem", "value_type": "deviation_status", "subject_role": "RESPONSE_TABLE", "fill_strategy": "generated_collection", "display_name": "偏离情况", "relation_path": ["当前项目", "投标文件", "响应表", "偏离情况"]},
    "deviation_notes": {"semantic_field": "bid_response.response_item.deviation_notes", "canonical_key": "deviation_notes", "entity_type": "ResponseItem", "value_type": "deviation_notes", "subject_role": "RESPONSE_TABLE", "fill_strategy": "generated_collection", "display_name": "偏离说明", "relation_path": ["当前项目", "投标文件", "响应表", "偏离说明"]},
    "action_only": {"action": true}
  },
  "role_labels": {
    "LEGAL_REPRESENTATIVE": "法定代表人",
    "AUTHORIZED_REPRESENTATIVE": "本项目授权代表",
    "PROJECT_MANAGER": "本项目项目负责人",
    "TECHNICAL_LEAD": "本项目技术负责人",
    "CONTACT_PERSON": "本项目联系人",
    "SIGNATORY": "本项目签署人"
  }
}
